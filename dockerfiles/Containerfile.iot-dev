FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ARG PLATFORMIO_VERSION=6.2.0

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        python3 \
        python3-venv \
        udev \
        usbutils \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/pio && \
    /opt/pio/bin/pip install --no-cache-dir "platformio==${PLATFORMIO_VERSION}" && \
    /opt/pio/bin/pio --version

COPY scripts/iot-pio /usr/local/bin/pio
RUN chmod 0755 /usr/local/bin/pio && \
    ln -s /usr/local/bin/pio /usr/local/bin/platformio
