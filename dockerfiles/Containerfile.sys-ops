FROM registry.fedoraproject.org/fedora-toolbox:latest

ARG POWERSHELL_VERSION=7.6.6
ARG POWERSHELL_SHA256=D3F9BCE6B6F0723DB49DDB4681FDEE2A332492BFD1238A305B0FBDB7825E786F

RUN dnf install -y \
        curl \
        krb5-workstation \
        bind-utils \
        iproute \
        jq && \
    curl -fsSL \
        "https://github.com/PowerShell/PowerShell/releases/download/v${POWERSHELL_VERSION}/powershell-${POWERSHELL_VERSION}-1.rh.x86_64.rpm" \
        -o /tmp/powershell.rpm && \
    echo "${POWERSHELL_SHA256}  /tmp/powershell.rpm" | sha256sum -c - && \
    rpm --import https://packages.microsoft.com/keys/microsoft.asc && \
    dnf install -y /tmp/powershell.rpm && \
    rm -f /tmp/powershell.rpm && \
    pwsh --version && \
    dnf clean all && \
    rm -rf /var/cache/dnf
