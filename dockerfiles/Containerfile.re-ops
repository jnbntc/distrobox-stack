FROM registry.fedoraproject.org/fedora:latest

ENV container=podman
ENV GHIDRA_VERSION=12.1.2_PUBLIC
ENV GHIDRA_BUILD=20260605
ENV GHIDRA_ZIP=ghidra_12.1.2_PUBLIC_20260605.zip
ENV JAVA_HOME=/usr/lib/jvm/java-25-openjdk

RUN dnf -y upgrade --refresh && \
    dnf -y install --setopt=install_weak_deps=False --nodocs \
        java-25-openjdk-devel wget unzip jq python3 python3-pip tmux \
    && dnf clean all && \
    rm -rf /var/cache/dnf && \
    test -x "$JAVA_HOME/bin/java" && \
    test -x "$JAVA_HOME/bin/javac" && \
    echo "ALL ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/zzzz-nopasswd && \
    chmod 0440 /etc/sudoers.d/zzzz-nopasswd

RUN wget -q "https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_12.1.2_build/${GHIDRA_ZIP}" -O /tmp/ghidra.zip && \
    unzip -q /tmp/ghidra.zip -d /opt/ && \
    rm /tmp/ghidra.zip && \
    ln -s "/opt/ghidra_${GHIDRA_VERSION}" /opt/ghidra && \
    test -x /opt/ghidra/support/analyzeHeadless

WORKDIR /ops
CMD ["/bin/bash"]
