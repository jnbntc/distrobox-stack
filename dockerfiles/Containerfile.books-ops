FROM registry.fedoraproject.org/fedora-toolbox:latest

RUN dnf -y install --setopt=install_weak_deps=False --nodocs \
        calibre \
        tor \
        torsocks \
        aria2 \
        curl \
        wget \
        jq \
        usbutils \
    && dnf clean all \
    && rm -rf /var/cache/dnf \
    && install -d -m 0755 /etc/tor/books-ops \
    && printf '%s\n' '# books-ops dedicated torrc' > /etc/tor/books-ops/torrc \
    && printf '%s\n' '# books-ops dedicated defaults' > /etc/tor/books-ops/torrc-defaults \
    && chmod 0644 /etc/tor/books-ops/torrc /etc/tor/books-ops/torrc-defaults

COPY scripts/books-tor.sh /usr/local/bin/books-tor
RUN chmod 0755 /usr/local/bin/books-tor

CMD ["/bin/bash"]
