FROM registry.fedoraproject.org/fedora-toolbox:latest

# hadolint ignore=DL4006
RUN dnf install -y \
    clinfo intel-compute-runtime libva-intel-media-driver \
    python3 zstd curl \
    oneapi-level-zero oneapi-level-zero-devel \
    ocl-icd ocl-icd-devel && \
    dnf clean all && \
    rm -rf /var/cache/dnf

RUN curl -LsSf -o install_uv.sh https://astral.sh/uv/install.sh && \
    sh install_uv.sh && \
    rm install_uv.sh

# Ruteo global absoluto para TODA la infraestructura de uv
ENV UV_TOOL_BIN_DIR=/usr/local/bin
ENV UV_TOOL_DIR=/opt/uv-tools
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python

RUN /root/.local/bin/uv tool install --python 3.12 aider-chat
