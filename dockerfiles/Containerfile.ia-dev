FROM registry.fedoraproject.org/fedora-toolbox:latest

# 1. Dependencias Base (Eliminamos gcc, pipx, numpy y devel)
RUN dnf install -y \
    clinfo intel-compute-runtime libva-intel-media-driver \
    python3 zstd curl \
    oneapi-level-zero oneapi-level-zero-devel \
    ocl-icd ocl-icd-devel && \
    dnf clean all && \
    rm -rf /var/cache/dnf

# 2. Instalación de uv (Gestor Rust)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# 3. Instalación global de Aider-chat vía uv
# Exponemos el binario directo en /usr/local/bin para evitar problemas de $PATH
RUN /root/.cargo/bin/uv tool install --dir /usr/local/bin aider-chat
