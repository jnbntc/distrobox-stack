FROM registry.fedoraproject.org/fedora-toolbox:latest

RUN dnf install -y \
    clinfo intel-compute-runtime libva-intel-media-driver \
    python3 zstd curl \
    oneapi-level-zero oneapi-level-zero-devel \
    ocl-icd ocl-icd-devel && \
    dnf clean all && \
    rm -rf /var/cache/dnf

# Descarga, ejecución secuencial y limpieza (cumple Hadolint orgánicamente sin pipes)
RUN curl -LsSf -o install_uv.sh https://astral.sh/uv/install.sh && \
    sh install_uv.sh && \
    rm install_uv.sh

RUN /root/.local/bin/uv tool install --dir /usr/local/bin aider-chat
